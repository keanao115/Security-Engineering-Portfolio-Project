# CyberMind SOC Platform Backend — Environment Configuration Template
# Copy this template to .env: cp .env.example .env

PORT=5000
PLATFORM_MODE=LIVE
ALLOW_RUNTIME_MODE_SWITCH=true

# Security Secrets (MANDATORY: server will not boot in production/live without this)
JWT_SECRET=replace_with_a_secure_random_32_character_jwt_secret_key_here

# Optional: Google Gemini AI API Key (Free key: https://aistudio.google.com/app/apikey)
# GEMINI_API_KEY=your_google_gemini_api_key_here

# Optional: NVD API Key for high-frequency CVE queries (https://nvd.nist.gov/developers/request-an-api-key)
# NVD_API_KEY=your_nvd_api_key_here

# Optional: PostgreSQL Database (Defaults to robust in-memory database if unconfigured)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=soc_db
DB_USER=postgres
DB_PASSWORD=postgres

# Syslog UDP Receiver Port
SYSLOG_PORT=5514
